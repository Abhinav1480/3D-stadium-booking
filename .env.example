# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Cloud SQL (PostgreSQL) Runtime Credentials (injected automatically by AI Studio)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"

# Cloud SQL (PostgreSQL) Admin Credentials for Drizzle Kit Schema Migrations
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# Redis (Optional for Docker Compose multi-node lock & pub/sub; falls back to in-process TTL broker)
REDIS_URL="redis://localhost:6379"

# Security & Payment Secrets (Test Mode Defaults Provided)
JWT_SECRET="stadiumx-jwt-secret-key-change-in-prod"
QR_HMAC_SECRET="stadiumx-qr-hmac-secret-key-2026"
RAZORPAY_KEY_ID="rzp_test_stadiumx_demo_key"
RAZORPAY_KEY_SECRET="rzp_test_stadiumx_webhook_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_stadiumx_secret_2026"
